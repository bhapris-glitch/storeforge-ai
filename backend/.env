# ======================================
# APP
# ======================================

NODE_ENV=development
PORT=5000

# ======================================
# DATABASE
# ======================================

MONGO_URI=mongodb://127.0.0.1:27017/storeforge-ai

# ======================================
# AUTH
# ======================================

JWT_SECRET=storeforge_super_secret_jwt_key_change_me
JWT_EXPIRE=30d

# ======================================
# FRONTEND
# ======================================

FRONTEND_URL=http://localhost:3000

# ======================================
# SHOPIFY
# ======================================

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_customers,write_customers

SHOPIFY_APP_URL=http://localhost:5000
===============================================

REDIS_URL=redis://127.0.0.1:6379

================================================

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=2
