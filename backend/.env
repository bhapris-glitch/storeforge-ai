# ======================================
# APP
# ======================================

NODE_ENV=development
PORT=5000

# ======================================
# DATABASE
# ======================================

MONGO_URI=mongodb://127.0.0.1:27017/storeforge-ai

# ======================================
# AUTH
# ======================================

JWT_SECRET=storeforge_super_secret_jwt_key_change_me
JWT_EXPIRE=30d

# ======================================
# FRONTEND
# ======================================

FRONTEND_URL=http://localhost:3000

# ======================================
# SHOPIFY
# ======================================

SHOPIFY_API_KEY=your_shopify_client_id
SHOPIFY_API_SECRET=your_shopify_client_secret

SHOPIFY_API_VERSION=2025-10

SHOPIFY_SCOPES=read_products,write_products,read_product_listings,read_inventory,write_inventory,read_orders,write_orders,read_customers,write_customers,read_themes,write_themes

SHOPIFY_REDIRECT_URI=https://your-backend-domain.com/api/shopify/callback

SHOPIFY_STATE_SECRET=your-long-random-secret
===============================================

REDIS_URL=redis://127.0.0.1:6379

================================================

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=2

================================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=20

THEME_RATE_LIMIT_WINDOW_MS=3600000
THEME_RATE_LIMIT_MAX_REQUESTS=5

=======================================
